  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- Consolida as transações por investidor e ticker para calcular a quantidade líquida real
net_positions as (
    select
        investor,
        ticker,
        sum(
            case 
                when lower(transaction_type) in ('compra', 'buy') then quantity
                when lower(transaction_type) in ('venda', 'sell') then -quantity
                else 0
            end
        ) as net_quantity,
        -- Pega o preço unitário mais recente ou faz uma média ponderada se preferir
        max(unit_price) as unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
    group by investor, ticker
),

-- Filtra apenas os ativos que ainda possuem saldo positivo na carteira
active_positions as (
    select *
    from net_positions
    where net_quantity > 0
)

select
    i.investor,
    i.ticker,
    i.net_quantity as quantity,
    i.unit_price,
    p.current_price as market_price,
    coalesce(i.net_quantity * i.unit_price, 0) as total_invested_brl,
    coalesce(i.net_quantity * p.current_price, coalesce(i.net_quantity * i.unit_price, 0)) as current_market_value_brl
from active_positions i
left join current_prices p on i.ticker = p.ticker
  );
