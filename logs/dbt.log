[0m08:31:34.707865 [debug] [Thread-1 (]: On model.statistic_dbt.fct_investments: /* {"app": "dbt", "dbt_version": "1.12.0rc2", "profile_name": "statistic_dbt", "target_name": "dev", "node_id": "model.statistic_dbt.fct_investments"} */

  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- Filtra estritamente apenas transações de COMPRA e VENDA válidas, ignorando taxas e proventos
valid_trades as (
    select *
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
),

-- Calcula a posição líquida apenas com base em compras e vendas reais
net_positions as (
    select
        investor,
        ticker,
        sum(
            case 
                when lower(transaction_type) in ('compra', 'buy') then quantity
                when lower(transaction_type) in ('venda', 'sell') then -quantity
                else 0
            end
        ) as net_quantity,
        sum(
            case 
                when lower(transaction_type) in ('compra', 'buy') then coalesce(total_amount, quantity * unit_price)
                when lower(transaction_type) in ('venda', 'sell') then -coalesce(total_amount, quantity * unit_price)
                else 0
            end
        ) as net_invested_brl
    from valid_trades
    group by investor, ticker
),

-- Mantém apenas ativos com saldo de quantidade positivo real
active_positions as (
    select 
        p.investor,
        p.ticker,
        p.net_quantity as quantity,
        case when p.net_quantity > 0 then greatest(p.net_invested_brl, 0) else 0 end as total_invested_brl
    from net_positions p
    where p.net_quantity > 0
)

select
    i.investor,
    i.ticker,
    i.quantity,
    i.total_invested_brl,
    cp.current_price as market_price,
    coalesce(i.quantity * cp.current_price, i.total_invested_brl) as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
