[0m08:14:15.439213 [debug] [Thread-1 (]: On model.statistic_dbt.fct_investments: /* {"app": "dbt", "dbt_version": "1.12.0rc2", "profile_name": "statistic_dbt", "target_name": "dev", "node_id": "model.statistic_dbt.fct_investments"} */

  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Normaliza o ticker e filtra apenas compras e vendas válidas
valid_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        quantity,
        total_amount,
        unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
),

-- 2. Calcula a quantidade líquida e o preço médio ponderado das COMPRAS
position_calc as (
    select
        investor,
        ticker,
        -- Quantidade líquida atual (Compras - Vendas)
        sum(
            case 
                when transaction_type in ('compra', 'buy') then quantity
                when transaction_type in ('venda', 'sell') then -quantity
                else 0
            end
        ) as net_quantity,
        
        -- Preço Médio de Compra (Soma do R$ investido nas compras / Soma da qtd comprada)
        coalesce(
            sum(case when transaction_type in ('compra', 'buy') then coalesce(total_amount, quantity * unit_price) else 0 end) 
            / nullif(sum(case when transaction_type in ('compra', 'buy') then quantity else 0 end), 0),
            0
        ) as avg_buy_price
    from valid_trades
    group by investor, ticker
),

-- 3. Mantém apenas ativos com saldo líquido real positivo (> 0)
active_positions as (
    select 
        p.investor,
        p.ticker,
        p.net_quantity as quantity,
        -- Custo Investido Real = Quantidade Restante * Preço Médio de Compra
        round((p.net_quantity * p.avg_buy_price)::numeric, 2) as total_invested_brl
    from position_calc p
    where p.net_quantity > 0.01  -- Garante que resíduos de centavos não fiquem na carteira
)

-- 4. Junta com as cotações de mercado do yfinance
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    i.total_invested_brl,
    cp.current_price as market_price,
    -- Valor de Mercado = Quantidade Restante * Cotação Atual do yfinance
    round((coalesce(i.quantity * cp.current_price, i.total_invested_brl))::numeric, 2) as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
