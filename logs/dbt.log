  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Normaliza o ticker e filtra compras e vendas válidas
valid_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        quantity,
        total_amount,
        unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
      and quantity > 0
),

-- 2. Calcula a quantidade líquida e o montante financeiro líquido real (Subtraindo as Vendas)
net_positions as (
    select
        investor,
        ticker,
        -- Quantidade líquida de cotas/dólares atuais
        sum(
            case 
                when transaction_type in ('compra', 'buy') then quantity
                when transaction_type in ('venda', 'sell') then -quantity
                else 0
            end
        ) as net_quantity,
        
        -- Montante financeiro líquido em BRL (Compras menos o valor de Resgate/Venda)
        sum(
            case 
                when transaction_type in ('compra', 'buy') then coalesce(total_amount, quantity * unit_price)
                when transaction_type in ('venda', 'sell') then -coalesce(total_amount, quantity * unit_price)
                else 0
            end
        ) as net_invested_brl
    from valid_trades
    group by investor, ticker
),

-- 3. Filtra ativos com saldo positivo real na carteira
active_positions as (
    select 
        p.investor,
        p.ticker,
        p.net_quantity as quantity,
        -- Garante que o custo investido líquido não fique negativo por pequenas distorções de arredondamento
        round(greatest(p.net_invested_brl, 0)::numeric, 2) as total_invested_brl
    from net_positions p
    where p.net_quantity > 0.01
      and p.net_invested_brl > 0.01
)

-- 4. Junta com o yfinance para o valor de mercado atual
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    i.total_invested_brl,
    cp.current_price as market_price,
    round((coalesce(i.quantity * cp.current_price, i.total_invested_brl))::numeric, 2) as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
