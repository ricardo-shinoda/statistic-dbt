  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Normaliza o ticker e padroniza as transações
valid_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        coalesce(quantity, 0) as quantity,
        coalesce(total_amount, quantity * unit_price, 0) as total_amount
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
),

-- 2. Pega a quantidade líquida e o montante financeiro líquido (Compras - Vendas)
net_positions as (
    select
        investor,
        ticker,
        sum(
            case 
                when transaction_type in ('compra', 'buy') then quantity
                when transaction_type in ('venda', 'sell') then -quantity
                else 0
            end
        ) as net_quantity,
        sum(
            case 
                when transaction_type in ('compra', 'buy') then total_amount
                when transaction_type in ('venda', 'sell') then -total_amount
                else 0
            end
        ) as net_invested_brl
    from valid_trades
    group by investor, ticker
),

-- 3. Filtra apenas o que tem saldo ativo real (> 0)
active_positions as (
    select 
        investor,
        ticker,
        net_quantity as quantity,
        greatest(net_invested_brl, 0) as total_invested_brl
    from net_positions
    where net_quantity > 0.01
      and net_invested_brl > 0.01
)

-- 4. Une com o preço de mercado atual da API
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    round(i.total_invested_brl::numeric, 2) as total_invested_brl,
    cp.current_price as market_price,
    round((coalesce(i.quantity * cp.current_price, i.total_invested_brl))::numeric, 2) as current_market_value_brl
from active_positions i
