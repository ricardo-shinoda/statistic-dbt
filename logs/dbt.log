  create  table "statistic_db"."analytics"."fct_investments__dbt_tmp"
  
  
    as
  
  (
    

with movements as (
    select * from "statistic_db"."analytics"."stg_investments"
),

investment_position as (
    select
        investor,`
        ticker,
        company_name,
        sum(case when transaction_type = 'compra' then quantity else -quantity end) as current_quantity,
        sum(case when transaction_type = 'compra' then total_amount else -total_amount end) as total_cost_basis,
        -- Average price
        sum(case when transaction_type = 'compra' then total_amount else -total_amount end) / 
        nullif(sum(case when transaction_type = 'compra' then quantity else 0 end), 0) as average_buy_price
    from movements
    group by 1, 2, 3
)

select 
    investor,
    ticker,
    company_name,
    current_quantity,
    average_buy_price,
    total_cost_basis as total_invested_brl
from investment_position
where current_quantity > 0
  );
  
