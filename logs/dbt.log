  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Normaliza tickers e padroniza transações
cleaned_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD', 'USDBRL=X') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        coalesce(quantity, 0) as quantity,
        coalesce(total_amount, 0) as total_amount,
        coalesce(unit_price, 0) as unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell', 'aplicação', 'resgate', 'rendimento')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
),

-- 2. Agregação por ativo para calcular quantidade líquida e montantes de compra
trade_aggregation as (
    select
        investor,
        ticker,
        sum(quantity) as net_quantity,
        -- Soma do valor financeiro total pago nas compras originais (Custo Histórico Real da planilha)
        sum(case when transaction_type in ('compra', 'buy') then total_amount else 0 end) as total_bought_brl,
        sum(case when transaction_type in ('compra', 'buy') then quantity else 0 end) as total_bought_qty,
        sum(total_amount) as net_amount_brl
    from cleaned_trades
    group by investor, ticker
),

-- 3. Posições ativas e definição do Custo Histórico
active_positions as (
    select 
        investor,
        ticker,
        net_quantity as quantity,
        case 
            -- Para Renda Fixa / CDBs / Reservas
            when upper(ticker) like '%CDB%' 
              or upper(ticker) like '%RESERVA%' 
              or upper(ticker) like '%TESOURO%' 
              or upper(ticker) like '%LCI%' 
              or upper(ticker) like '%LCA%' then round(greatest(net_amount_brl, 0)::numeric, 2)
            
            -- Para Dólar, Ações e FIIs: Custo Histórico proporcional ao saldo remanescente baseado no preço médio de compra
            else round((net_quantity * (case when total_bought_qty > 0 then total_bought_brl / total_bought_qty else 0 end))::numeric, 2)
        end as total_invested_brl
    from trade_aggregation
    where net_quantity > 0.01 
       or net_amount_brl > 0.01
)

-- 4. Cruzamento final com o preço atual de mercado (yfinance)
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    i.total_invested_brl, -- Custo histórico real baseado nas compras
    cp.current_price as market_price,
    case 
        -- Valor atualizado pela cotação de hoje da API
        when cp.current_price is not null and cp.current_price > 0 
            then round((i.quantity * cp.current_price)::numeric, 2)
        else i.total_invested_brl
    end as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
