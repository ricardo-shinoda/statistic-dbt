[0m08:11:39.491632 [debug] [Thread-1 (]: On model.statistic_dbt.fct_investments: /* {"app": "dbt", "dbt_version": "1.12.0rc2", "profile_name": "statistic_dbt", "target_name": "dev", "node_id": "model.statistic_dbt.fct_investments"} */

  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Padroniza o Ticker do Dólar para bater com o yfinance (USDBRL=X)
normalized_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        transaction_type,
        quantity,
        total_amount,
        unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
),

-- 2. Considera APENAS Compra e Venda para somar/subtrair quantidade e custo histórico
net_positions as (
    select
        investor,
        ticker,
        sum(
            case 
                when lower(transaction_type) in ('compra', 'buy') then quantity
                when lower(transaction_type) in ('venda', 'sell') then -quantity
                else 0
            end
        ) as net_quantity,
        sum(
            case 
                when lower(transaction_type) in ('compra', 'buy') then coalesce(total_amount, quantity * unit_price)
                when lower(transaction_type) in ('venda', 'sell') then -coalesce(total_amount, quantity * unit_price)
                else 0
            end
        ) as total_invested_brl
    from normalized_trades
    group by investor, ticker
),

-- 3. Mantém apenas ativos com saldo de quantidade positivo real (> 0)
active_positions as (
    select 
        p.investor,
        p.ticker,
        p.net_quantity as quantity,
        greatest(p.total_invested_brl, 0) as total_invested_brl
    from net_positions p
    where p.net_quantity > 0
      and p.total_invested_brl > 0
)

-- 4. Junta com a cotação atual do yfinance para o Valor de Mercado
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    i.total_invested_brl, -- Custo histórico real da planilha
    cp.current_price as market_price,
    -- Valor de mercado atualizado: Quantidade atual * Cotação ao vivo de hoje
    coalesce(i.quantity * cp.current_price, i.total_invested_brl) as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
