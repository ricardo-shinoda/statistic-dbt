[0m08:40:04.318921 [debug] [Thread-1 (]: On model.statistic_dbt.fct_investments: /* {"app": "dbt", "dbt_version": "1.12.0rc2", "profile_name": "statistic_dbt", "target_name": "dev", "node_id": "model.statistic_dbt.fct_investments"} */

  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Normaliza tickers e filtra operações válidas
cleaned_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        coalesce(quantity, 0) as quantity,
        coalesce(total_amount, quantity * unit_price, 0) as total_amount,
        coalesce(unit_price, 0) as unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
),

-- 2. Agregação separada por compras e vendas
trade_totals as (
    select
        investor,
        ticker,
        -- Quantidades líquidas
        sum(case when transaction_type in ('compra', 'buy') then quantity else 0 end) as bought_qty,
        sum(case when transaction_type in ('venda', 'sell') then quantity else 0 end) as sold_qty,
        -- Montantes financeiros em R$
        sum(case when transaction_type in ('compra', 'buy') then total_amount else 0 end) as bought_brl,
        sum(case when transaction_type in ('venda', 'sell') then total_amount else 0 end) as sold_brl
    from cleaned_trades
    group by investor, ticker
),

-- 3. Cálculo de posições com regras específicas por classe de ativo
position_calc as (
    select
        investor,
        ticker,
        (bought_qty - sold_qty) as net_quantity,
        (bought_brl - sold_brl) as net_amount_brl,
        
        -- Preço médio de compra (para ações/FIIs/Dólar)
        case 
            when bought_qty > 0 then bought_brl / bought_qty
            else 0
        end as avg_buy_price
    from trade_totals
),

-- 4. Posições ativas reais e custo histórico blindado
active_positions as (
    select 
        investor,
        ticker,
        net_quantity as quantity,
        case 
            -- Para o DÓLAR: Quantidade líquida restante * Preço médio das compras
            when ticker = 'USDBRL=X' then round((net_quantity * avg_buy_price)::numeric, 2)
            
            -- Para Renda Fixa / CDBs (onde o ticker contém CDB, TESOURO, LCI, LCA ou RESERVA): Usa o saldo financeiro líquido direto
            when upper(ticker) like '%CDB%' 
              or upper(ticker) like '%RESERVA%' 
              or upper(ticker) like '%TESOURO%' 
              or upper(ticker) like '%LCI%' 
              or upper(ticker) like '%LCA%' then round(greatest(net_amount_brl, 0)::numeric, 2)
            
            -- Para Ações e FIIs: Quantidade de cotas * Preço médio de compra
            else round((net_quantity * avg_buy_price)::numeric, 2)
        end as total_invested_brl
    from position_calc
    where net_quantity > 0.01 
       or net_amount_brl > 0.01
)

-- 5. Cruzamento com cotação atual do yfinance
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    i.total_invested_brl,
    cp.current_price as market_price,
    case 
        -- Se houver preço na API (como USDBRL=X, Ações, FIIs), multiplica a quantidade líquida pela cotação
        when cp.current_price is not null and i.ticker = 'USDBRL=X' 
            then round((i.quantity * cp.current_price)::numeric, 2)
        when cp.current_price is not null and cp.current_price > 0 
            then round((i.quantity * cp.current_price)::numeric, 2)
        -- Para Renda Fixa sem API de preço diário, o Valor de Mercado equivale ao Valor Investido/Saldo Líquido
        else i.total_invested_brl
    end as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
