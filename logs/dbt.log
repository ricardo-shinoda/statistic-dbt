[0m08:31:02.367766 [debug] [Thread-1 (]: On model.statistic_dbt.fct_investments: /* {"app": "dbt", "dbt_version": "1.12.0rc2", "profile_name": "statistic_dbt", "target_name": "dev", "node_id": "model.statistic_dbt.fct_investments"} */

  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Normaliza e limpa transações válidas
valid_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        coalesce(quantity, 0) as quantity,
        coalesce(total_amount, quantity * unit_price, 0) as total_amount,
        coalesce(unit_price, 0) as unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
      and quantity > 0
),

-- 2. Agrega compras e vendas separadamente para calcular a posição e o custo proporcional
trade_summary as (
    select
        investor,
        ticker,
        sum(case when transaction_type in ('compra', 'buy') then quantity else 0 end) as total_bought_qty,
        sum(case when transaction_type in ('venda', 'sell') then quantity else 0 end) as total_sold_qty,
        sum(case when transaction_type in ('compra', 'buy') then total_amount else 0 end) as total_bought_brl
    from valid_trades
    group by investor, ticker
),

-- 3. Calcula o saldo líquido e o custo baseado no preço médio ponderado das aquisições
position_calc as (
    select
        investor,
        ticker,
        (total_bought_qty - total_sold_qty) as net_quantity,
        -- Preço médio unitário das compras
        case 
            when total_bought_qty > 0 then total_bought_brl / total_bought_qty
            else 0
        end as avg_unit_price
    from trade_summary
),

-- 4. Filtra apenas posições ativas reais
active_positions as (
    select 
        investor,
        ticker,
        net_quantity as quantity,
        -- Custo Histórico = Quantidade que sobrou * Preço Médio de Compra
        round((net_quantity * avg_unit_price)::numeric, 2) as total_invested_brl
    from position_calc
    where net_quantity > 0.01
)

-- 5. Une com o yfinance para o valor de mercado atual
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    i.total_invested_brl,
    cp.current_price as market_price,
    round((coalesce(i.quantity * cp.current_price, i.total_invested_brl))::numeric, 2) as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
