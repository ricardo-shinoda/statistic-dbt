  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

filtered_investments as (
    select *
    from investments
    where quantity > 0  -- Remove ativos que não estão mais na carteira
      and upper(ticker) not in ('TAXA LIQUIDAÇÃO', 'IRRF S/ OPERAÇÕES', 'EMOLUMENTOS') -- Remove taxas e impostos
      and ticker is not null
)

select
    i.*,
    p.current_price as market_price,
    coalesce(i.quantity * i.unit_price, 0) as total_invested_brl,
    coalesce(i.quantity * p.current_price, coalesce(i.quantity * i.unit_price, 0)) as current_market_value_brl
from filtered_investments i
left join current_prices p on i.ticker = p.ticker
  );
