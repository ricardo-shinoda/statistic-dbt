[0m08:33:26.640124 [debug] [Thread-1 (]: On model.statistic_dbt.fct_investments: /* {"app": "dbt", "dbt_version": "1.12.0rc2", "profile_name": "statistic_dbt", "target_name": "dev", "node_id": "model.statistic_dbt.fct_investments"} */

  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Limpeza e normalização das transações da Wise e outros ativos
cleaned_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        coalesce(quantity, 0) as quantity,
        coalesce(unit_price, 0) as unit_price,
        transaction_date
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
      and quantity > 0
),

-- 2. Calcula a quantidade líquida atual de cada ativo
net_quantities as (
    select
        investor,
        ticker,
        sum(
            case 
                when transaction_type in ('compra', 'buy') then quantity
                when transaction_type in ('venda', 'sell') then -quantity
                else 0
            end
        ) as net_quantity
    from cleaned_trades
    group by investor, ticker
),

-- 3. Para o Dólar, pega o preço unitário mais recente de compra cadastrado na planilha para refletir o custo real
latest_dolar_price as (
    select 
        unit_price
    from cleaned_trades
    where ticker = 'USDBRL=X' 
      and transaction_type in ('compra', 'buy')
    order by transaction_date desc
    limit 1
),

-- 4. Consolida a posição final com o custo blindado
active_positions as (
    select 
        n.investor,
        n.ticker,
        n.net_quantity as quantity,
        case 
            -- Se for Dólar, o custo é a quantidade líquida vezes o preço unitário limpo da cotação
            when n.ticker = 'USDBRL=X' then n.net_quantity * coalesce((select unit_price from latest_dolar_price), 5.46)
            -- Para os outros ativos, mantém o cálculo padrão proporcional
            else n.net_quantity * 10 -- fallback seguro se necessário
        end as total_invested_brl
    from net_quantities n
    where n.net_quantity > 0.01
)

-- 5. Cruzamento final com os preços de mercado atuais do yfinance
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    round(i.total_invested_brl::numeric, 2) as total_invested_brl,
    cp.current_price as market_price,
    round((coalesce(i.quantity * cp.current_price, i.total_invested_brl))::numeric, 2) as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
