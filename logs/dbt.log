[0m08:25:08.591566 [debug] [Thread-1 (]: On model.statistic_dbt.fct_investments: /* {"app": "dbt", "dbt_version": "1.12.0rc2", "profile_name": "statistic_dbt", "target_name": "dev", "node_id": "model.statistic_dbt.fct_investments"} */

  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Normaliza o ticker e filtra compras e vendas válidas
valid_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        quantity,
        coalesce(total_amount, quantity * unit_price, 0) as total_amount,
        unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
      and quantity > 0
),

-- 2. Agrega os totais de quantidade e montante financeiro para compras e vendas separadamente
trade_aggregates as (
    select
        investor,
        ticker,
        sum(case when transaction_type in ('compra', 'buy') then quantity else 0 end) as bought_qty,
        sum(case when transaction_type in ('venda', 'sell') then quantity else 0 end) as sold_qty,
        sum(case when transaction_type in ('compra', 'buy') then total_amount else 0 end) as bought_brl,
        sum(case when transaction_type in ('venda', 'sell') then total_amount else 0 end) as sold_brl
    from valid_trades
    group by investor, ticker
),

-- 3. Calcula a posição líquida de quantidade e abate proporcionalmente o custo das vendas
position_calc as (
    select
        investor,
        ticker,
        (bought_qty - sold_qty) as net_quantity,
        -- Custo líquido proporcional: o que foi gasto nas compras menos o custo alocado das vendas
        case 
            when bought_qty > 0 then greatest((bought_brl - (sold_qty * (bought_brl / bought_qty))), 0)
            else 0
        end as net_invested_brl
    from trade_aggregates
),

-- 4. Filtra posições ativas reais (> 0)
active_positions as (
    select 
        investor,
        ticker,
        net_quantity as quantity,
        round(net_invested_brl::numeric, 2) as total_invested_brl
    from position_calc
    where net_quantity > 0.01
      and net_invested_brl > 0.01
)

-- 5. Junta com o yfinance para o valor de mercado atual
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    i.total_invested_brl,
    cp.current_price as market_price,
    round((coalesce(i.quantity * cp.current_price, i.total_invested_brl))::numeric, 2) as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
