current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Limpeza e normalização das transações
cleaned_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        coalesce(quantity, 0) as quantity,
        coalesce(unit_price, 0) as unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
      and quantity > 0
),

-- 2. Calcula a quantidade líquida atual e o preço unitário padrão de referência de cada ativo
position_summary as (
    select
        investor,
        ticker,
        sum(
            case 
                when transaction_type in ('compra', 'buy') then quantity
                when transaction_type in ('venda', 'sell') then -quantity
                else 0
            end
        ) as net_quantity,
        -- Pega o preço unitário mais comum/recente das compras para este ativo
        max(case when transaction_type in ('compra', 'buy') then unit_price else 0 end) as ref_unit_price
    from cleaned_trades
    group by investor, ticker
),

-- 3. Consolida a posição final com o custo proporcional real
active_positions as (
    select 
        investor,
        ticker,
        net_quantity as quantity,
        case 
            when ticker = 'USDBRL=X' then net_quantity * coalesce(nullif(ref_unit_price, 0), 5.46)
            else net_quantity * coalesce(nullif(ref_unit_price, 0), 10)
        end as total_invested_brl
    from position_summary
    where net_quantity > 0.01
)

-- 4. Cruzamento final com os preços de mercado atuais do yfinance
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    round(i.total_invested_brl::numeric, 2) as total_invested_brl,
    cp.current_price as market_price,
    round((coalesce(i.quantity * cp.current_price, i.total_invested_brl))::numeric, 2) as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
