  create  table "statistic_db"."analytics"."fct_unified_payments__dbt_tmp"
  
  
    as
  
  (
    

with pix_payments as (
    select
        payment_id,
        purchased_at,
        amount_brl,
        payment_type,
        description,
        comments,
        tipo_gasto,
        category_name,
        subcategory_name1,
