[0m08:15:07.784906 [debug] [Thread-1 (]: On model.statistic_dbt.fct_investments: /* {"app": "dbt", "dbt_version": "1.12.0rc2", "profile_name": "statistic_dbt", "target_name": "dev", "node_id": "model.statistic_dbt.fct_investments"} */

  create view "statistic_db"."analytics"."fct_investments__dbt_tmp"
    
    
  as (
    with investments as (
    select * from "statistic_db"."analytics"."stg_investments"
),

current_prices as (
    select * from "statistic_db"."analytics"."stg_current_prices"
),

-- 1. Normaliza o ticker e valida apenas compras e vendas reais
valid_trades as (
    select
        investor,
        case 
            when upper(trim(ticker)) in ('DOLAR', 'DÓLAR', 'USD') then 'USDBRL=X'
            else upper(trim(ticker))
        end as ticker,
        lower(transaction_type) as transaction_type,
        quantity,
        unit_price
    from investments
    where ticker is not null
      and trim(ticker) <> ''
      and trim(ticker) <> '-'
      and lower(transaction_type) in ('compra', 'buy', 'venda', 'sell')
      and upper(ticker) not in (
          'TAXA LIQUIDAÇÃO', 
          'IRRF S/ OPERAÇÕES', 
          'IRRS S/ OPERAÇÕES', 
          'EMOLUMENTOS', 
          'CORRETAGEM', 
          'ISS'
      )
      and quantity > 0
      and unit_price > 0
),

-- 2. Calcula a quantidade líquida e o preço médio ponderado real baseado no unit_price
position_calc as (
    select
        investor,
        ticker,
        sum(
            case 
                when transaction_type in ('compra', 'buy') then quantity
                when transaction_type in ('venda', 'sell') then -quantity
                else 0
            end
        ) as net_quantity,
        
        -- Média ponderada do preço unitário de compra
        sum(case when transaction_type in ('compra', 'buy') then quantity * unit_price else 0 end) 
        / nullif(sum(case when transaction_type in ('compra', 'buy') then quantity else 0 end), 0) as avg_unit_price
    from valid_trades
    group by investor, ticker
),

-- 3. Filtra ativos com saldo positivo real
active_positions as (
    select 
        p.investor,
        p.ticker,
        p.net_quantity as quantity,
        -- Custo Real = Quantidade Líquida Atual * Preço Médio Unitário de Aquisição
        round((p.net_quantity * coalesce(p.avg_unit_price, 0))::numeric, 2) as total_invested_brl
    from position_calc p
    where p.net_quantity > 0.01
)

-- 4. Junta com o yfinance para o valor de mercado atual
select
    i.investor,
    case when i.ticker = 'USDBRL=X' then 'DÓLAR' else i.ticker end as ticker,
    i.quantity,
    i.total_invested_brl,
    cp.current_price as market_price,
    round((coalesce(i.quantity * cp.current_price, i.total_invested_brl))::numeric, 2) as current_market_value_brl
from active_positions i
left join current_prices cp on i.ticker = cp.ticker
  );
